{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(npm run *)",
      "Bash(npx tsx *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(npx eslint *)",
      "Bash(npx shadcn@latest *)",
      "Bash(npx tsc *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(chmod *)",
      "Edit(app/**)",
      "Edit(components/**)",
      "Edit(lib/**)",
      "Edit(types/**)",
      "Edit(tests/**)",
      "Edit(scripts/**)",
      "Edit(supabase/**)",
      "Edit(docs/**)",
      "Edit(*.ts)",
      "Edit(*.tsx)",
      "Edit(*.md)",
      "Edit(*.json)",
      "Edit(*.css)",
      "Edit(*.sql)",
      "Write(app/**)",
      "Write(components/**)",
      "Write(lib/**)",
      "Write(types/**)",
      "Write(tests/**)",
      "Write(scripts/**)",
      "Write(supabase/**)",
      "Write(docs/**)",
      "Write(.claude/**)",
      "Write(*.ts)",
      "Write(*.tsx)",
      "Write(*.md)",
      "Write(*.json)",
      "Write(*.css)",
      "Write(*.sql)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Write(.env.local)",
      "Write(.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/lint-typecheck.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/sql-rls-check.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/docs-update-check.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
